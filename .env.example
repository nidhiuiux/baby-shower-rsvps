# Where RSVP emails are sent (overrides src/lib/event.ts notifyEmail)
NOTIFY_EMAIL=nsavaliya93@gmail.com

# Required for email delivery — free at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Required for confirmations to guests: use an address on your verified Resend domain.
# The fallback onboarding@resend.dev sender only works for your Resend account inbox.
# NOTIFY_FROM_EMAIL=Nidhi & Hardik <celebrate@your-verified-domain.com>

# Private PIN for the /host page. Overrides the fallback in src/lib/event.ts.
HOST_PIN=choose-a-private-pin

# Optional local data directory. Leave unset to keep using data/rsvps.json.
# RSVP_DATA_DIR=/absolute/path/to/local-rsvp-data
